{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Helm 차트·컨테이너 이미지 버전 업데이트 PR. GitHub Actions는 Dependabot(.github/dependabot.yml)이 담당",
  "extends": ["config:recommended", ":timezone(Asia/Seoul)", "schedule:weekly", ":semanticCommitsDisabled"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "enabledManagers": ["argocd", "kubernetes", "custom.regex", "gomod", "dockerfile"],
  "postUpdateOptions": ["gomodTidy"],
  "argocd": {
    "managerFilePatterns": ["/^k8s/apps/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/monitoring/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "description": "CI 도구 릴리스 바이너리 (Trivy·cosign·Sloth, 체크섬 확인 설치)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/lab-api\\.yml$/", "/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["TRIVY_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+) # (?<depName>aquasecurity/trivy)", "COSIGN_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+) # (?<depName>sigstore/cosign)", "SLOTH_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+) # (?<depName>slok/sloth)", "KYVERNO_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+) # (?<depName>kyverno/kyverno)"],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "description": "kube-prometheus-stack 차트 버전 (CI 렌더링 검증, 부트스트랩 스크립트)",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/", "/^k8s/monitoring/kps/deploy\\.ps1$/"],
      "matchStrings": ["CHART_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)", "\\$chartVersion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "kube-prometheus-stack",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://prometheus-community.github.io/helm-charts"
    },
    {
      "description": "argo-cd 차트 버전 (Argo CD 자신은 helm으로 설치: install.ps1 + CI 렌더링 검증)",
      "customType": "regex",
      "managerFilePatterns": ["/^k8s/argocd/install\\.ps1$/", "/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["\\$chartVersion = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"", "argo/argo-cd --version (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "argo-cd",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "description": "values.yaml 문자열(extraContainers) 안의 Thanos 이미지",
      "customType": "regex",
      "managerFilePatterns": ["/^k8s/monitoring/kps/values\\.yaml$/"],
      "matchStrings": ["image: (?<depName>quay\\.io/thanos/thanos):(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "kps 차트는 Argo 앱·CI·스크립트를 한 PR로. CRD는 Argo가 관리하지 않으므로 안내",
      "matchPackageNames": ["kube-prometheus-stack"],
      "groupName": "kube-prometheus-stack",
      "prBodyNotes": [
        "⚠ **CRD 수동 적용 필요**: kps 앱은 `skipCrds: true`라 Argo CD가 CRD를 갱신하지 않습니다. 머지 전에 새 차트의 CRD를 `kubectl apply --server-side`로 먼저 적용하세요.",
        "⚠ values의 리스트 설정(cAdvisorMetricRelabelings 등)은 차트 기본값을 덮어씁니다. 새 버전의 기본 규칙 변경 여부를 확인하세요.",
        "Prometheus CR 변경분은 Operator를 켜야 반영됩니다 (평소 replicas 0)."
      ]
    },
    {
      "description": "Argo CD 차트는 Argo가 아니라 install.ps1로 적용",
      "matchPackageNames": ["argo-cd"],
      "groupName": "argo-cd",
      "prBodyNotes": ["머지 후 `k8s\\argocd\\install.ps1` 실행 필요 (Argo CD 자신은 Argo로 관리하지 않음)."]
    },
    {
      "description": "Thanos 이미지는 Operator 기본 sidecar 버전과 맞춰야 함 (sidecar 버전은 Operator가 결정)",
      "matchPackageNames": ["quay.io/thanos/thanos"],
      "prBodyNotes": ["sidecar 버전은 Prometheus Operator(kps 차트)가 정합니다. Query 버전을 크게 앞서지 않도록 kps 업그레이드와 함께 검토하세요."]
    },
    {
      "description": "python 이미지는 3.13 계열 안에서만 (budget-guard·backup 스크립트 호환)",
      "matchPackageNames": ["python"],
      "allowedVersions": "/^3\\.13\\./"
    }
  ]
}
