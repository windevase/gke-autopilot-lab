  "tags": [
    "lab",
    "ops",
    "cloudflare"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "워크로드 가동 상태 (오프아워·예산 자동 차단 효과)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "state-timeline",
      "title": "Deployment / StatefulSet 레플리카",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Grafana·cloudflared는 평일 10~20시만 가동, Operator는 설정 변경 때만. 예산 초과 시 budget-guard가 전부 0으로 내림",
      "gridPos": {
        "h": 7,
        "w": 18,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "정지",
                  "color": "#808080",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 100,
                "result": {
                  "text": "가동",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (deployment) (kube_deployment_spec_replicas{namespace=\"monitoring\"})",
          "legendFormat": "{{deployment}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (statefulset) (kube_statefulset_replicas{namespace=\"monitoring\"})",
          "legendFormat": "{{statefulset}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "지금 정지된 워크로드",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
