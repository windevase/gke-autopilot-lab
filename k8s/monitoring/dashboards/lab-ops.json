    {
      "type": "table",
      "title": "CronJob 상태",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "grafana-scale-up이 '정지됨'이면 예산 자동 차단이 동작한 것 (CLAUDE.md 복구 절차)",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "마지막 성공"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "다음 실행까지"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "활성",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "정지됨",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cronjob) (kube_cronjob_spec_suspend{namespace=\"monitoring\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (cronjob) (kube_cronjob_status_last_successful_time{namespace=\"monitoring\"})",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cronjob) (kube_cronjob_next_schedule_time{namespace=\"monitoring\"}) - time()",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "cronjob": "CronJob",
              "Value #A": "상태",
              "Value #B": "마지막 성공",
              "Value #C": "다음 실행까지"
            }
          }
        }
      ],
      "id": 5
