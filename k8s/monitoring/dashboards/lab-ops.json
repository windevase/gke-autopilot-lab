        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(max by (deployment) (kube_deployment_spec_replicas{namespace=\"monitoring\"}) == 0) or vector(0)) + (count(max by (statefulset) (kube_statefulset_replicas{namespace=\"monitoring\"}) == 0) or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
