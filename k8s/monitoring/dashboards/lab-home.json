          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-billing"
          },
          "refId": "A",
          "rawSql": "SELECT IFNULL(SAFE_DIVIDE(SUM(cost) + SUM(IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c WHERE c.type = 'FREE_TIER'), 0)), $budget_krw), 0) AS value FROM `billing_export.gcp_billing_export_v1_*` WHERE invoice.month = FORMAT_TIMESTAMP('%Y%m', CURRENT_TIMESTAMP(), 'America/Los_Angeles')",
          "rawQuery": true,
          "editorMode": "code",
          "format": 1,
          "location": "US"
        }
