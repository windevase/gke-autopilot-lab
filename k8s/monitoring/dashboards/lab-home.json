      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "bigquery-billing"
          },
          "refId": "A",
          "rawSql": "SELECT IFNULL(ROUND(SUM(cost) + SUM(IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0))), 0) AS value FROM `billing_export.gcp_billing_export_v1_*` WHERE invoice.month = FORMAT_TIMESTAMP('%Y%m', CURRENT_TIMESTAMP(), 'America/Los_Angeles')",
          "rawQuery": true,
          "editorMode": "code",
          "format": 1,
          "location": "US"
        }
      ],
      "id": 3
    },
    {
      "type": "gauge",
      "title": "예산 대비 (₩$budget_krw)",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "bigquery-billing"
      },
      "description": "100%면 budget-guard가 워크로드를 자동으로 0으로 내림",
      "gridPos": {
