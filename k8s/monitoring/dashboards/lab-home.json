          "rawSql": "SELECT IFNULL(ROUND(SAFE_DIVIDE(SUM(cost / currency_conversion_rate), TIMESTAMP_DIFF(CURRENT_TIMESTAMP(), TIMESTAMP_TRUNC(CURRENT_TIMESTAMP(), MONTH, 'America/Los_Angeles'), SECOND) / (86400 * EXTRACT(DAY FROM LAST_DAY(CURRENT_DATE('America/Los_Angeles'))))), 2), 0) AS value FROM `billing_export.gcp_billing_export_v1_*` WHERE invoice.month = FORMAT_TIMESTAMP('%Y%m', CURRENT_TIMESTAMP(), 'America/Los_Angeles')",
